# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Secrets (none found, kept as a guard) ---
.env
.env.*
*.key
*.pem

# --- Model weights (large; ultralytics downloads them by name on first run) ---
# yolov8x-pose.pt is 139 MB, over GitHub's 100 MB file limit.
*.pt

# --- Regenerated by run_pipeline.py (extracted frames, ~9 MB) ---
data/frames/

# --- Large / raw video (keep only the small clip and the annotated output) ---
*.mov
*.avi
*.mkv
*.mp4
!input_video.mp4
!outputs/annotated_swing.mp4

# --- LaTeX build files (keep .tex, .pdf and figures/) ---
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
